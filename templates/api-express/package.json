{
	"name": "@template/api-express",
	"version": "0.0.1",
	"private": true,
	"description": "",
	"keywords": [],
	"bugs": {
		"url": "https://github.com/builder-group/community/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/community.git"
	},
	"license": "MIT",
	"author": "@bennobuilder",
	"type": "module",
	"exports": {
		"./openapi": "./src/openapi/index.ts",
		"./openapi.json": "./openapi.json",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "pnpm typecheck && shx rm -rf dist && esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=dist/server.js",
		"clean": "shx rm -rf dist && shx rm -rf .turbo && shx rm -rf node_modules",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint .",
		"openapi:generate": "pnpm run openapi:generate:runtime && pnpm run openapi:generate:types",
		"openapi:generate:runtime": "tsx scripts/generate-openapi-runtime.ts",
		"openapi:generate:types": "openapi-typescript openapi.json -o src/openapi/api-v1.gen.ts",
		"start": "NODE_ENV=production node --env-file-if-exists=.env.local dist/server.js",
		"start:dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
		"test": "echo \"🧪 No tests defined yet.\"",
		"typecheck": "tsc --noEmit && tsc -p scripts/tsconfig.json",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"openapi-ts-router": "workspace:*",
		"validatenv": "workspace:*",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@blgc/config": "workspace:*",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^26.1.2",
		"esbuild": "^0.28.1",
		"openapi-typescript": "^7.13.0",
		"tsx": "^4.23.1"
	}
}
