{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "TypeScript configuration for libraries",
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		// Language and Environment
		"lib": ["esnext"],
		"target": "esnext",

		// Modules
		"module": "commonjs",
		"moduleResolution": "bundler",

		// JavaScript Support
		"allowJs": true
	},
	"include": ["src"]
}
