{
	"name": "rollup-presets",
	"version": "0.0.28",
	"private": false,
	"description": "Rollup presets for TypeScript libraries with package export discovery, ESM/CJS output, and declarations",
	"keywords": [
		"rollup",
		"rollup-preset",
		"typescript",
		"typescript-library",
		"library-build",
		"bundler",
		"esm",
		"cjs",
		"declarations",
		"dts",
		"tsconfig-paths",
		"package-exports"
	],
	"homepage": "https://builder.group/?utm_source=package-json",
	"bugs": {
		"url": "https://github.com/builder-group/community/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/community.git"
	},
	"license": "MIT",
	"author": "@bennobuilder",
	"main": "./dist/index.js",
	"source": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "shx rm -rf dist && tsc",
		"clean": "shx rm -rf dist && shx rm -rf .turbo && shx rm -rf node_modules",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint .",
		"publish:patch": "pnpm build && pnpm version patch --no-git-tag-version && pnpm publish --no-git-checks --access=public",
		"start:dev": "tsc -w",
		"test": "vitest run",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"@rollup/plugin-commonjs": "^29.0.2",
		"execa": "9.6.1",
		"picocolors": "^1.1.1",
		"rollup-plugin-dts": "^6.4.1",
		"rollup-plugin-esbuild": "^6.2.1",
		"rollup-plugin-node-externals": "9.0.1"
	},
	"devDependencies": {
		"@blgc/config": "workspace:*",
		"@types/node": "^25.9.1",
		"rollup": "^4.60.4",
		"type-fest": "^5.6.0"
	}
}
