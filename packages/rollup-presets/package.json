{
	"name": "rollup-presets",
	"version": "0.0.3",
	"private": false,
	"description": "Collection of Rollup presets",
	"keywords": [],
	"homepage": "https://builder.group/?source=package-json",
	"bugs": {
		"url": "https://github.com/builder-group/community/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/community.git"
	},
	"license": "MIT",
	"author": "@bennobuilder",
	"main": "./dist/index.js",
	"source": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "shx rm -rf dist && tsc",
		"build:prod": "pnpm build -t prod",
		"clean": "shx rm -rf dist && shx rm -rf .turbo && shx rm -rf node_modules",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint . --fix",
		"publish:patch": "pnpm build:prod && pnpm version patch && pnpm publish --no-git-checks --access=public",
		"start:dev": "tsc -w",
		"test": "vitest run",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"@rollup/plugin-commonjs": "^28.0.2",
		"execa": "8.0.1",
		"picocolors": "^1.1.1",
		"rollup-plugin-esbuild": "^6.2.1",
		"rollup-plugin-node-externals": "5.1.3"
	},
	"devDependencies": {
		"@blgc/config": "workspace:*",
		"@types/node": "^22.13.5",
		"rollup": "^4.34.8",
		"type-fest": "^4.35.0"
	}
}
