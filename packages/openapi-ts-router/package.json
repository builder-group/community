{
	"name": "openapi-ts-router",
	"version": "0.4.1",
	"private": false,
	"description": "Typed Express and Hono route helpers backed by OpenAPI paths and Standard Schema validation",
	"keywords": [
		"openapi",
		"openapi-typescript",
		"router",
		"typed-router",
		"express",
		"hono",
		"standard-schema",
		"request-validation",
		"api-validation",
		"typescript",
		"type-safe",
		"zod",
		"valibot"
	],
	"homepage": "https://builder.group/?utm_source=package-json",
	"bugs": {
		"url": "https://github.com/builder-group/community/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/community.git"
	},
	"license": "MIT",
	"author": "@bennobuilder",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"source": "./src/index.ts",
			"import": "./dist/esm/index.js",
			"require": "./dist/cjs/index.js",
			"default": "./dist/cjs/index.js"
		},
		"./express": {
			"types": "./dist/types/express/index.d.ts",
			"source": "./src/express/index.ts",
			"import": "./dist/express/esm/index.js",
			"require": "./dist/express/cjs/index.js",
			"default": "./dist/express/cjs/index.js"
		},
		"./hono": {
			"types": "./dist/types/hono/index.d.ts",
			"source": "./src/hono/index.ts",
			"import": "./dist/hono/esm/index.js",
			"require": "./dist/hono/cjs/index.js",
			"default": "./dist/hono/cjs/index.js"
		},
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			".": [
				"./dist/types/index.d.ts"
			],
			"express": [
				"./dist/types/express/index.d.ts"
			],
			"hono": [
				"./dist/types/hono/index.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"README.md",
		"MIGRATION.md"
	],
	"scripts": {
		"build": "shx rm -rf dist && rollup -c rollup.config.js",
		"build:prod": "export NODE_ENV=production && pnpm build",
		"clean": "shx rm -rf dist && shx rm -rf .turbo && shx rm -rf node_modules",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint .",
		"publish:patch": "pnpm build:prod && pnpm version patch --no-git-tag-version && pnpm publish --no-git-checks --access=public",
		"size": "size-limit --why",
		"start:dev": "tsc -w",
		"test": "vitest run",
		"test:types": "vitest run --typecheck.only",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"@standard-schema/spec": "^1.1.0",
		"openapi-typescript-helpers": "^0.1.0"
	},
	"devDependencies": {
		"@blgc/config": "workspace:*",
		"@types/express": "^5.0.6",
		"@types/node": "^26.1.1",
		"express": "^5.2.1",
		"hono": "^4.12.30",
		"rollup-presets": "workspace:*",
		"valibot": "1.4.2"
	},
	"peerDependencies": {
		"@types/express": "^5.0.6",
		"express": "^5.2.1",
		"hono": "^4.12.21"
	},
	"peerDependenciesMeta": {
		"@types/express": {
			"optional": true
		},
		"express": {
			"optional": true
		},
		"hono": {
			"optional": true
		}
	},
	"size-limit": [
		{
			"path": "dist/esm/index.js"
		},
		{
			"path": "dist/express/esm/index.js"
		},
		{
			"path": "dist/hono/esm/index.js"
		}
	]
}
