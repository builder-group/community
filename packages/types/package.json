{
	"name": "@blgc/types",
	"version": "0.0.20",
	"private": false,
	"description": "A collection of utility types",
	"keywords": [],
	"homepage": "https://builder.group/?utm_source=package-json",
	"bugs": {
		"url": "https://github.com/builder-group/community/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/community.git"
	},
	"license": "MIT",
	"author": "@bennobuilder",
	"exports": {
		"./api": {
			"types": "./dist/api/index.d.ts",
			"source": "./src/api/index.ts"
		},
		"./openapi": {
			"types": "./dist/openapi/index.d.ts",
			"source": "./src/openapi/index.ts"
		},
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"source": "./src/utils/index.ts"
		},
		"./features": {
			"types": "./dist/features/index.d.ts",
			"source": "./src/features/index.ts"
		}
	},
	"typesVersions": {
		"*": {
			"api": [
				"./dist/api/index.d.ts"
			],
			"openapi": [
				"./dist/openapi/index.d.ts"
			],
			"utils": [
				"./dist/utils/index.d.ts"
			],
			"features": [
				"./dist/features/index.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "shx rm -rf dist && rollup -c rollup.config.js",
		"build:prod": "export NODE_ENV=production && pnpm build",
		"clean": "shx rm -rf dist && shx rm -rf .turbo && shx rm -rf node_modules",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint . --fix",
		"publish:patch": "pnpm build:prod && pnpm version patch && pnpm publish --no-git-checks --access=public",
		"update:latest": "pnpm update --latest"
	},
	"devDependencies": {
		"@blgc/config": "workspace:*",
		"rollup-presets": "workspace:*"
	}
}
