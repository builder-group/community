{
	"name": "head-metadata",
	"version": "0.0.13",
	"private": false,
	"description": "Typed HTML head metadata extraction for title, meta, link, and custom extractors",
	"keywords": [
		"html",
		"metadata",
		"head-metadata",
		"head",
		"meta-tags",
		"open-graph",
		"twitter-card",
		"seo",
		"title",
		"link-tags",
		"typescript",
		"extractor",
		"xml-tokenizer"
	],
	"homepage": "https://builder.group/?utm_source=package-json",
	"bugs": {
		"url": "https://github.com/builder-group/community/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/community.git"
	},
	"license": "MIT",
	"author": "@bennobuilder",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"source": "./src/index.ts",
	"types": "./dist/types/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "shx rm -rf dist && rollup -c rollup.config.js",
		"build:prod": "export NODE_ENV=production && pnpm build",
		"clean": "shx rm -rf dist && shx rm -rf .turbo && shx rm -rf node_modules",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint .",
		"publish:patch": "pnpm build:prod && pnpm version patch --no-git-tag-version && pnpm publish --no-git-checks --access=public",
		"size": "size-limit --why",
		"start:dev": "tsc -w",
		"test": "vitest run",
		"update:latest": "pnpm update --latest"
	},
	"dependencies": {
		"xml-tokenizer": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "^25.9.2",
		"rollup-presets": "workspace:*"
	},
	"size-limit": [
		{
			"path": "dist/esm/index.js"
		}
	]
}
